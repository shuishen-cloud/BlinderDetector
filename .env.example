# 复制为 .env 后使用：cp .env.example .env
#
# 本期全部走 mock，不填任何 key 也能完整跑通全链路。

# ---- 实现选择（见 app/core/registry.py）----
VLM_PROVIDER=mock          # mock | dashscope | zhipu | openai
DETECTOR=mock              # 障碍物检测器（第二层）
FRAME_SOURCE=video         # video | images

# ---- 云端 VLM（本期不接，仅占位）----
# 三家都提供 OpenAI 兼容端点，换厂商只改这三行
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_TIMEOUT_MS=8000

# ---- 第三层：路线数据源（见 app/core/routers/）----
# builtin = 内置假路网（不依赖网络，默认）| baidu = 百度地图步行路线规划
ROUTER=builtin

# 百度地图 AK。★ 三个前提，缺一个都会失败：
#   1. 需要实名认证；
#   2. 要在控制台给这个 AK 勾选「步行路线规划（轻量）」权限
#      （2018-11-14 之前注册的 AK 默认没有）；
#   3. 默认收 BD-09 坐标，本项目传 coord_type=wgs84 让百度自己换算。
# 百度**没有**「避开天桥/台阶/地下通道」的参数，所以真实地图只能做警告，
# 不能声称「已避开」—— 详见 app/core/rules/route.py 的模块注释。
BAIDU_AK=
BAIDU_TIMEOUT_MS=5000

# 开发开关：配了就从这个本地 JSON 读响应代替 HTTP 请求，
# 没有 AK 也能把「真实响应 → 解析 → 警告 → 降级」整条链跑通。
BAIDU_FIXTURE=

# ---- 调试台地图用的浏览器端 AK（百度 JSAPI GL）----
# ★ 与上面的 BAIDU_AK 是**两个不同的东西**，不能混用：
#   上面那个是「服务端」AK（服务端调 Web 服务 API 算路线）；
#   这个要新建一个「浏览器端」AK（在网页里画地图）。
#   应用类型选错、或没在控制台勾选对应的服务，都会失败。
# 留空时调试台的地图卡片显示「地图未配置」，其余功能照常。
BAIDU_BROWSER_AK=

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*             # 逗号分隔；* 仅适合开发
