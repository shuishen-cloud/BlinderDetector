# 复制为 .env 后使用：cp .env.example .env
#
# 本期全部走 mock，不填任何 key 也能完整跑通全链路。

# ---- 实现选择（见 app/core/registry.py）----
VLM_PROVIDER=mock          # mock | dashscope | zhipu | openai
DETECTOR=mock              # 障碍物检测器（第二层）
FRAME_SOURCE=video         # video | images

# ---- 云端 VLM（本期不接，仅占位）----
# 三家都提供 OpenAI 兼容端点，换厂商只改这三行
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_TIMEOUT_MS=8000

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*             # 逗号分隔；* 仅适合开发
